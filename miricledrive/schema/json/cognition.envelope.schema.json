{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sov1.ai/miricledrive/schema/cognition.envelope.schema.json",
  "title": "MiricleDrive Cognition Envelope Schema",
  "description": "Canonical commitment object for human-AI cognition artifacts. The envelope is the unit that is canonicalized, hashed, chained, signed, promoted, and later redacted without breaking ledger integrity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "created_at",
    "canonicalization",
    "content_commitments",
    "generation_context",
    "authorship",
    "reproducibility",
    "governance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "miricledrive.cognition_envelope.v1"
    },
    "envelope_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_thread_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "source_turn_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "source_message_ids": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "status"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["rfc8785_json_canonicalization", "miricledrive_v1_canonical_json", "not_canonicalized"]
        },
        "status": {
          "type": "string",
          "enum": ["canonical", "provisional", "not_canonicalized"]
        },
        "unicode_normalization": {
          "type": "string",
          "enum": ["NFC", "NFKC", "none", "unknown"],
          "default": "NFC"
        },
        "null_handling": {
          "type": "string",
          "enum": ["preserve_nulls", "omit_nulls", "unknown"],
          "default": "preserve_nulls"
        },
        "array_order_rule": {
          "type": "string",
          "enum": ["source_order", "sorted_by_id", "sorted_by_hash", "unknown"],
          "default": "source_order"
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "content_commitments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_hash", "hash_algorithm", "content_separation_mode"],
      "properties": {
        "envelope_hash": {
          "type": ["string", "null"],
          "description": "Hash of the canonical envelope excluding signature fields. May be null while provisional."
        },
        "hash_algorithm": {
          "type": "string",
          "enum": ["sha256", "sha512", "blake3", "unknown"]
        },
        "content_separation_mode": {
          "type": "string",
          "enum": ["inline_content", "external_content_pointer", "hash_only", "redacted_tombstone_ready"]
        },
        "prompt_hash": { "type": ["string", "null"] },
        "response_hash": { "type": ["string", "null"] },
        "system_prompt_hash": { "type": ["string", "null"] },
        "context_window_hash": { "type": ["string", "null"] },
        "tool_outputs_hash": { "type": ["string", "null"] },
        "source_export_hash": { "type": ["string", "null"] },
        "redactable_content_hashes": {
          "type": "array",
          "items": { "$ref": "#/$defs/content_hash_pointer" },
          "default": []
        }
      }
    },
    "content_pointers": {
      "type": "array",
      "items": { "$ref": "#/$defs/content_pointer" },
      "default": []
    },
    "generation_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_role", "platform", "model_provider", "model_name", "model_version_status"],
      "properties": {
        "artifact_role": {
          "type": "string",
          "enum": ["human_prompt", "ai_response", "tool_output", "system_message", "human_correction", "model_comparison", "human_judgment", "mixed_thread", "unknown"]
        },
        "platform": { "type": ["string", "null"] },
        "model_provider": { "type": ["string", "null"] },
        "model_name": { "type": ["string", "null"] },
        "model_version": { "type": ["string", "null"] },
        "model_version_status": {
          "type": "string",
          "enum": ["exact", "reported", "approximate", "hidden", "unknown", "not_applicable"]
        },
        "conversation_id": { "type": ["string", "null"] },
        "request_id": { "type": ["string", "null"] },
        "parameters_json": { "type": ["object", "null"] },
        "hidden_context_known": { "type": "boolean", "default": false },
        "hidden_context_notes": { "type": ["string", "null"] },
        "tool_invocation_ids": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "authorship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorship_boundary", "source_authority", "human_origin_present"],
      "properties": {
        "authorship_boundary": {
          "type": "string",
          "enum": ["human_origin", "ai_generated", "human_ai_coauthored", "tool_generated", "mixed", "unknown"]
        },
        "source_authority": {
          "type": "string",
          "enum": ["primary_human", "human_supplied", "model_output", "tool_output", "third_party", "unknown"]
        },
        "human_origin_present": { "type": "boolean" },
        "ai_generated_present": { "type": "boolean", "default": false },
        "third_party_content_present": { "type": "boolean", "default": false },
        "authorship_notes": { "type": ["string", "null"] }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["reproducible", "partially_reproducible", "not_reproducible", "unknown"]
        },
        "reason": { "type": ["string", "null"] },
        "missing_reproduction_factors": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["model_weights", "hidden_system_prompt", "seed", "sampling_parameters", "retrieval_context", "tool_state", "model_revision", "safety_layer", "unknown"]
          },
          "default": []
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_level", "continuity_authority_status", "render_policy"],
      "properties": {
        "evidence_level": {
          "type": "string",
          "enum": ["recorded", "derived", "inferred", "uncertain", "missing", "forbidden"]
        },
        "continuity_authority_status": {
          "type": "string",
          "enum": ["none", "pending_human_adjudication", "human_promoted", "human_rejected", "blocked"]
        },
        "render_policy": {
          "type": "string",
          "enum": ["may_quote", "may_summarize_with_citation", "human_review_required", "do_not_render"]
        },
        "promotion_required": { "type": "boolean", "default": true },
        "lowest_trust_ancestor_class": {
          "type": "string",
          "enum": ["primary_human", "human_supplied", "model_output", "tool_output", "third_party", "unknown"]
        },
        "third_party_scope": {
          "type": "string",
          "enum": ["none_detected", "possible", "confirmed", "restricted", "unknown"],
          "default": "unknown"
        },
        "redaction_eligible": { "type": "boolean", "default": true }
      }
    },
    "ledger_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prior_ledger_head": { "type": ["string", "null"] },
        "event_id": { "type": ["string", "null"], "format": "uuid" },
        "new_ledger_head": { "type": ["string", "null"] },
        "binding_status": {
          "type": "string",
          "enum": ["bound", "unbound", "provisional"],
          "default": "unbound"
        }
      }
    },
    "notes": { "type": ["string", "null"] }
  },
  "$defs": {
    "content_pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer_id", "pointer_type", "hash", "storage_policy"],
      "properties": {
        "pointer_id": { "type": "string" },
        "pointer_type": {
          "type": "string",
          "enum": ["inline", "artifact_ref", "external_uri", "sealed_blob", "redacted", "unknown"]
        },
        "artifact_id": { "type": ["string", "null"], "format": "uuid" },
        "uri": { "type": ["string", "null"] },
        "hash": { "type": ["string", "null"] },
        "hash_algorithm": { "type": "string", "enum": ["sha256", "sha512", "blake3", "unknown"], "default": "sha256" },
        "storage_policy": {
          "type": "string",
          "enum": ["normal", "sealed", "redactable", "tombstoned", "external_only"]
        },
        "byte_range": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "content_hash_pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "hash", "redaction_behavior"],
      "properties": {
        "label": { "type": "string" },
        "hash": { "type": ["string", "null"] },
        "hash_algorithm": { "type": "string", "enum": ["sha256", "sha512", "blake3", "unknown"], "default": "sha256" },
        "redaction_behavior": {
          "type": "string",
          "enum": ["preserve_hash_remove_content", "seal_content", "remove_hash_and_content_if_required", "unknown"]
        }
      }
    }
  }
}
